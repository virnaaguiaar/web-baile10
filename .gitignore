# Combined .gitignore for both local and remote settings

# PlatformIO
.pio

# VSCode settings
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# Vercel deployment files
.vercel

# Environment files
.env*
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Node.js dependencies
/node_modules
/.pnp
.pnp.js

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test coverage output
/coverage

# Production build output
/build

# Miscellaneous
.DS_Store